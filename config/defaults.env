# Claude Talk - Default Configuration
# Override any value in ~/.claude-talk/config.env

# === Audio ===
# Microphone device: "auto" to detect, or numeric index to override
# List devices: python3 -c "import sounddevice; print(sounddevice.query_devices())"
AUDIO_DEVICE=auto

# Microphone gain multiplier
# MacBook Pro built-in mic needs ~8.0, external USB mics ~1.0-2.0
MIC_GAIN=8.0

# === whisper.cpp STT (pywhispercpp) ===
WHISPER_MODEL=small.en
# VAD aggressiveness 0-3 (2=balanced, 3=aggressive noise rejection)
VAD_AGGRESSIVENESS=2
# Consecutive 20ms silent frames to end utterance (50=1s)
VAD_SILENCE_FRAMES=50

# === Voice Activity Detection ===
# Seconds of silence to mark end of utterance
SILENCE_SECS=1.0

# === Interrupt Detection ===
# Uses BlackHole 2ch as TTS reference signal (Geigel double-talk detection)
# Auto-detects BlackHole; disabled if not found. Set BARGE_IN=false to force off.
BARGE_IN=true
# BLACKHOLE_DEVICE=  # auto-detect by default; set explicit index to override
BARGE_IN_RATIO=0.5

# === Text-to-Speech ===
# Default personality template for new sessions
DEFAULT_PERSONALITY=claude
# macOS say voice (used as fallback for _resolve_kokoro_voice if no Kokoro Voice in personality)
VOICE=Daniel

# Kokoro model (mlx-audio neural TTS)
KOKORO_MODEL=mlx-community/Kokoro-82M-bf16
# Default Kokoro voice (overridden by personality Kokoro Voice field)
KOKORO_VOICE=bm_daniel
# Speech speed multiplier (0.5 = half speed, 2.0 = double)
KOKORO_SPEED=1.0

# === Audio Server ===
AUDIO_SERVER_PORT=8150

# === Python Virtual Environments ===
WLK_VENV="$HOME/.claude-talk/venvs/wlk"
VAD_VENV="$HOME/.claude-talk/venvs/vad"
